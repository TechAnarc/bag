#!/usr/bin/env bash
set -euo pipefail

if [ -n "${FIGMA_PUBLIC_URL:-}" ]; then
  FIGMA_HOST="$(node -e 'try { console.log(new URL(process.env.FIGMA_PUBLIC_URL).hostname) } catch {}')"
  if [ -n "$FIGMA_HOST" ]; then
    export __VITE_ADDITIONAL_SERVER_ALLOWED_HOSTS="$FIGMA_HOST"
  fi
fi

# Start Express backend on port 4000 when required backend credentials are present
if [ -n "${DATABASE_URL:-}" ] && [ -n "${ADMIN_EMAIL:-}" ] && [ -n "${ADMIN_PASSWORD:-}" ]; then
  trap 'kill 0' SIGINT SIGTERM
  (
    cd backend
    if [ ! -f .env ] && [ -z "${JWT_ACCESS_SECRET:-}" ]; then
      export JWT_ACCESS_SECRET="$(node -e "process.stdout.write(require('crypto').randomBytes(32).toString('hex'))")"
      export JWT_REFRESH_SECRET="$(node -e "process.stdout.write(require('crypto').randomBytes(32).toString('hex'))")"
      export ADMIN_JWT_SECRET="$(node -e "process.stdout.write(require('crypto').randomBytes(32).toString('hex'))")"
    fi
    PORT=4000 \
    NODE_ENV="${NODE_ENV:-development}" \
    FRONTEND_URL="${FIGMA_PUBLIC_URL:-http://localhost:${PORT}}" \
    CORS_ORIGIN="${FIGMA_PUBLIC_URL:-http://localhost:${PORT}}" \
    CORS_ALLOWED_ORIGINS="http://localhost:8080,http://localhost:5173${FIGMA_PUBLIC_URL:+,${FIGMA_PUBLIC_URL}}" \
    BACKEND_URL="http://localhost:4000" \
    npm run dev:unsafe
  ) &
  npm run dev -- --port "$PORT" --host &
  wait
else
  exec npm run dev -- --port "$PORT" --host
fi
