generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id                    String                 @id @default(uuid())
  name                  String
  slug                  String                 @unique
  domain                String?                @unique
  settings              Json?
  status                String                 @default("ACTIVE")
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  businessConfig        BusinessConfig?
  categories            Category[]
  deliveryAgents        DeliveryAgent[]
  invoices              Invoice[]
  ledgerEntries         LedgerEntry[]
  notificationTemplates NotificationTemplate[]
  orders                Order[]
  orderAnalytics        OrderAnalytic[]
  products              Product[]
  users                 User[]
  webhookSubscriptions  WebhookSubscription[]
  workflowRules         WorkflowRule[]

  @@index([slug])
  @@index([status])
}

model User {
  id              String            @id @default(uuid())
  tenantId        String?
  name            String
  email           String?           @unique
  phone           String?           @unique
  passwordHash    String
  role            Role              @default(USER)
  avatar          String?
  lastLoginAt     DateTime?
  loginCount      Int               @default(0)
  isBlocked       Boolean           @default(false)
  blockedReason   String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  isEmailVerified Boolean           @default(false)
  isPhoneVerified Boolean           @default(false)
  status          String            @default("ACTIVE")
  cart            CartItem[]
  orders          Order[]
  otpSessions     OtpSession[]
  reviews         Review[]
  tenant          Tenant?           @relation(fields: [tenantId], references: [id])
  addresses       UserAddress[]
  intelligence    UserIntelligence?
  profile         UserProfile?
  security        UserSecurity?
  wishlist        WishlistItem[]

  @@index([email])
  @@index([phone])
  @@index([isBlocked])
}

model UserAddress {
  id           String   @id @default(uuid())
  userId       String
  label        String   @default("Home")
  name         String
  phone        String
  addressLine1 String
  addressLine2 String?
  city         String
  state        String
  pincode      String
  country      String   @default("India")
  isDefault    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model OtpSession {
  id           String    @id @default(uuid())
  userId       String?
  email        String?
  phone        String?
  otpHash      String
  type         OtpType
  status       OtpStatus @default(PENDING)
  expiresAt    DateTime
  attempts     Int       @default(0)
  resendCount  Int       @default(0)
  lastResentAt DateTime?
  ipAddress    String?
  userAgent    String?
  requestId    String?   @unique
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  user         User?     @relation(fields: [userId], references: [id])

  @@index([email])
  @@index([phone])
  @@index([status])
}

model UserSecurity {
  id                    String    @id @default(uuid())
  userId                String    @unique
  twoFactorEnabled      Boolean   @default(false)
  preferred2FAMethod    String?   @default("EMAIL")
  backupCodes           Json?
  lastPasswordChangedAt DateTime?
  securityScore         Float     @default(0)
  lastSecurityCheckAt   DateTime?
  trustedDevices        Json?
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id        String    @id @default(uuid())
  actorType ActorType
  actorId   String
  action    String
  metadata  Json?
  ip        String?
  userAgent String?
  createdAt DateTime  @default(now())

  @@index([actorId])
  @@index([action])
  @@index([createdAt])
}

model DeletedUser {
  id               String   @id @default(uuid())
  tenantId         String?
  originalUserId   String   @unique
  name             String
  email            String
  phone            String?
  passwordHash     String
  role             Role
  avatar           String?
  address          Json?
  accountCreatedAt DateTime
  accountDeletedAt DateTime @default(now())
  deletionReason   String?
  orderCount       Int      @default(0)
  totalSpent       Float    @default(0)

  @@index([email])
  @@index([originalUserId])
  @@index([accountDeletedAt])
  @@index([tenantId])
}

model Product {
  id               String                 @id @default(uuid())
  tenantId         String?
  name             String
  slug             String                 @unique
  sku              String?                @unique
  categoryId       String
  price            Float
  discountPrice    Float?
  gstIncluded      Boolean                @default(true)
  platingType      String?
  shortTagline     String?
  description      String?
  images           String[]
  thumbnail        String?
  specifications   Json?
  careInstructions String?                @default("After each use, gently wipe your jewelry with a soft cloth. Store in a cool, dry place away from direct sunlight. Avoid immersing your jewelry in water. Refrain from cleaning with soap or harsh chemicals.")
  badges           String[]               @default(["Fine Precious Metals", "Handmade in India", "Everyday Luxury", "Insured Shipping"])
  inventory        Json?
  seo              Json?
  status           ProductStatus          @default(ACTIVE)
  isActive         Boolean                @default(true)
  isFeatured       Boolean                @default(false)
  isTrending       Boolean                @default(false)
  tags             String[]               @default([])
  views            Int                    @default(0)
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  basePrice        Float?                 @default(0)
  sellingPrice     Float?                 @default(0)
  ownerPrice       Float?                 @default(0)
  cartItems        CartItem[]
  reservations     InventoryReservation[]
  orderItems       OrderItem[]
  category         Category               @relation(fields: [categoryId], references: [id])
  tenant           Tenant?                @relation(fields: [tenantId], references: [id])
  reviews          Review[]
  wishlistItems    WishlistItem[]

  @@index([categoryId])
  @@index([status])
  @@index([isActive])
  @@index([slug])
  @@index([sku])
  @@index([name])
  @@index([tenantId])
}

model Review {
  id              String       @id @default(uuid())
  productId       String
  userId          String?
  name            String
  email           String?
  profileImageUrl String?
  rating          Int
  reviewText      String?
  status          ReviewStatus @default(PENDING)
  isVerified      Boolean      @default(false)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  content         String?
  displayName     String?
  images          String[]     @default([])
  isApproved      Boolean      @default(true)
  isHelpful       Int          @default(0)
  title           String?
  product         Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  user            User?        @relation(fields: [userId], references: [id])

  @@index([productId])
  @@index([userId])
  @@index([status])
  @@index([rating])
  @@index([createdAt])
  @@index([isApproved])
}

model Category {
  id          String    @id @default(uuid())
  tenantId    String?
  name        String    @unique
  slug        String    @unique
  description String?
  image       String?
  icon        String?
  isActive    Boolean   @default(true)
  sortOrder   Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  gender      String?   @default("UNISEX")
  skuPrefix   String?
  tenant      Tenant?   @relation(fields: [tenantId], references: [id])
  products    Product[]

  @@index([slug])
  @@index([isActive])
  @@index([tenantId])
}

model Order {
  id                String               @id @default(uuid())
  tenantId          String?
  orderNumber       String               @unique
  userId            String
  subtotal          Float
  discount          Float                @default(0)
  tax               Float                @default(0)
  shippingCharge    Float                @default(0)
  total             Float
  status            OrderStatus          @default(PENDING)
  paymentStatus     PaymentStatus        @default(PENDING)
  paymentMethod     PaymentMethod
  shippingAddress   Json
  billingAddress    Json?
  razorpayOrderId   String?
  razorpayPaymentId String?
  razorpaySignature String?
  trackingNumber    String?
  estimatedDelivery DateTime?
  deliveredAt       DateTime?
  customerNotes     String?
  adminNotes        String?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  slaDeadline       DateTime?
  isEscalated       Boolean              @default(false)
  escalationReason  String?
  isFlagged         Boolean              @default(false)
  riskLevel         String               @default("LOW")
  deliveryAgentId   String?
  idempotencyKey    String?              @unique
  riskReport        Json?
  riskScore         Float                @default(0)
  fraudScore        Float                @default(0)
  invoice           Invoice?
  ledgerEntries     LedgerEntry[]
  deliveryAgent     DeliveryAgent?       @relation(fields: [deliveryAgentId], references: [id])
  tenant            Tenant?              @relation(fields: [tenantId], references: [id])
  user              User                 @relation(fields: [userId], references: [id])
  items             OrderItem[]
  timeline          OrderTimelineEvent[]
  shipment          Shipment?

  @@index([userId])
  @@index([orderNumber])
  @@index([status])
  @@index([paymentStatus])
  @@index([createdAt])
  @@index([deliveryAgentId])
  @@index([isEscalated])
  @@index([isFlagged])
  @@index([tenantId])
}

model InventoryReservation {
  id        String            @id @default(uuid())
  productId String
  orderId   String
  quantity  Int
  status    ReservationStatus @default(RESERVED)
  expiresAt DateTime
  createdAt DateTime          @default(now())
  product   Product           @relation(fields: [productId], references: [id])

  @@index([productId])
  @@index([orderId])
  @@index([status])
}

model WorkflowRule {
  id           String   @id @default(uuid())
  tenantId     String?
  name         String
  triggerEvent String
  conditions   Json?
  actions      Json
  isActive     Boolean  @default(true)
  priority     Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  tenant       Tenant?  @relation(fields: [tenantId], references: [id])

  @@index([triggerEvent, isActive])
  @@index([tenantId])
}

model NotificationTemplate {
  id        String   @id @default(uuid())
  tenantId  String?
  name      String   @unique
  subject   String?
  content   String
  platform  String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenant    Tenant?  @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
}

model WebhookSubscription {
  id        String   @id @default(uuid())
  tenantId  String?
  url       String
  event     String
  secret    String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  tenant    Tenant?  @relation(fields: [tenantId], references: [id])

  @@index([event, isActive])
  @@index([tenantId])
}

model OrderAnalytic {
  id               String   @id @default(uuid())
  tenantId         String?
  date             DateTime @unique
  totalOrders      Int      @default(0)
  totalRevenue     Float    @default(0)
  completionRate   Float    @default(0)
  averageDuration  Float    @default(0)
  cancellationRate Float    @default(0)
  topProductId     String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  tenant           Tenant?  @relation(fields: [tenantId], references: [id])

  @@index([date])
  @@index([tenantId])
}

model OrderTimelineEvent {
  id          String      @id @default(uuid())
  orderId     String
  status      OrderStatus
  title       String
  description String?
  timestamp   DateTime    @default(now())
  actor       String
  metadata    Json?
  order       Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([status])
}

model DeliveryAgent {
  id            String   @id @default(uuid())
  tenantId      String?
  name          String
  phone         String   @unique
  vehicleType   String?
  vehicleNumber String?
  active        Boolean  @default(true)
  currentLat    Float?
  currentLng    Float?
  lastUpdated   DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  tenant        Tenant?  @relation(fields: [tenantId], references: [id])
  orders        Order[]

  @@index([active])
  @@index([phone])
  @@index([tenantId])
}

model OrderItem {
  id        String   @id @default(uuid())
  orderId   String
  productId String
  quantity  Int
  price     Float
  discount  Float    @default(0)
  subtotal  Float
  createdAt DateTime @default(now())
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id])

  @@index([orderId])
  @@index([productId])
}

model CartItem {
  id        String   @id @default(uuid())
  userId    String
  productId String
  quantity  Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([userId])
  @@index([productId])
}

model WishlistItem {
  id        String   @id @default(uuid())
  userId    String
  productId String
  createdAt DateTime @default(now())
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([userId])
  @@index([productId])
}

model ContactSubmission {
  id        String   @id @default(uuid())
  name      String
  email     String
  phone     String?
  subject   String?
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  isReplied Boolean   @default(false)
  replyText String?
  repliedAt DateTime?
  repliedBy String?

  @@index([isRead])
  @@index([isReplied])
  @@index([createdAt])
}

model LedgerEntry {
  id          String     @id @default(uuid())
  tenantId    String
  orderId     String?
  type        LedgerType
  amount      Float
  currency    String     @default("INR")
  source      String
  description String?
  metadata    Json?
  createdAt   DateTime   @default(now())
  order       Order?     @relation(fields: [orderId], references: [id])
  tenant      Tenant     @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@index([orderId])
  @@index([type])
  @@index([createdAt])
}

model OrderReadModel {
  id             String   @id @default(uuid())
  tenantId       String
  orderNumber    String   @unique
  customerName   String
  customerEmail  String
  totalAmount    Float
  status         String
  paymentStatus  String
  itemCount      Int
  lastEventTitle String?
  isEscalated    Boolean  @default(false)
  isFlagged      Boolean  @default(false)
  createdAt      DateTime
  updatedAt      DateTime @default(now())

  @@index([tenantId])
  @@index([status])
  @@index([customerEmail])
  @@index([createdAt])
}

model Admin {
  id           String        @id @default(uuid())
  name         String
  email        String        @unique
  passwordHash String
  role         AdminRole     @default(ADMIN)
  avatar       String?
  phone        String?
  isActive     Boolean       @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  fcmToken     String?
  devices      AdminDevice[]
  logs         AdminLog[]

  @@index([email])
  @@index([role])
  @@index([isActive])
}

model AdminDevice {
  id         String   @id @default(uuid())
  adminId    String
  deviceId   String   @unique
  fcmToken   String?
  deviceName String?
  deviceType String?
  lastUsedAt DateTime @default(now())
  createdAt  DateTime @default(now())
  admin      Admin    @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId])
}

model AdminLog {
  id        String   @id @default(uuid())
  adminId   String
  action    String
  details   Json?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  admin     Admin    @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId])
  @@index([createdAt])
  @@index([action])
}

model Invoice {
  id                   String    @id @default(uuid())
  tenantId             String?
  invoiceNumber        String    @unique
  invoiceVersion       String    @default("1.0")
  orderId              String    @unique
  invoiceDate          DateTime  @default(now())
  dueDate              DateTime?
  fiscalYear           String
  subtotal             Float
  discount             Float     @default(0)
  taxableAmount        Float
  cgst                 Float     @default(0)
  sgst                 Float     @default(0)
  igst                 Float     @default(0)
  gstRate              Float
  shippingCharge       Float     @default(0)
  codCharge            Float     @default(0)
  roundingAdjustment   Float     @default(0)
  grandTotal           Float
  gstType              String
  placeOfSupply        String
  sellerGSTIN          String
  sellerPAN            String?
  sellerCIN            String?
  itemsHSN             Json
  paymentMethod        String
  paymentStatus        String
  paymentDate          DateTime?
  paymentTransactionId String?
  paymentGateway       String?
  courierName          String?
  trackingNumber       String?
  estimatedDelivery    DateTime?
  pdfUrl               String?
  pdfGeneratedAt       DateTime?
  pdfHash              String?
  pdfVersion           String    @default("1.0")
  digitalSignature     String?
  signedBy             String?
  signedAt             DateTime?
  verificationQR       String?
  paymentQR            String?
  barcodeData          String?
  watermark            String?
  copyType             String    @default("ORIGINAL")
  legalDeclarations    Json?
  termsAndConditions   String?
  returnPolicy         String?
  templateId           String    @default("luxury-v1")
  themeVariant         String    @default("LIGHT")
  generatedBy          String?
  regenerationCount    Int       @default(0)
  notes                String?
  metadata             Json?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  order                Order     @relation(fields: [orderId], references: [id])
  tenant               Tenant?   @relation(fields: [tenantId], references: [id])

  @@index([invoiceNumber])
  @@index([orderId])
  @@index([invoiceDate])
  @@index([paymentStatus])
  @@index([fiscalYear])
  @@index([tenantId])
  @@index([pdfHash])
}

model BusinessConfig {
  id                  String   @id @default(uuid())
  tenantId            String   @unique
  businessName        String
  registeredAddress   Json
  phone               String
  email               String
  website             String?
  gstin               String
  pan                 String?
  cin                 String?
  stateCode           String
  logo                String?
  logoVector          String?
  brandColorPrimary   String   @default("#D4AF37")
  brandColorSecondary String   @default("#1A1A1A")
  brandColorAccent    String   @default("#FAFAFA")
  authorizedSignatory String
  signatureImage      String?
  designation         String?
  companyStamp        String?
  jurisdiction        String   @default("Gujarat")
  returnPolicyDays    Int      @default(7)
  legalText           String?
  disclaimer          String?
  invoicePrefix       String   @default("TRIVENI-INV")
  invoiceStartNumber  Int      @default(1)
  defaultTerms        String?
  showPricesWithGST   Boolean  @default(true)
  bankName            String?
  bankAccountNumber   String?
  bankIFSC            String?
  bankBranch          String?
  upiId               String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  tenant              Tenant   @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@index([gstin])
}

model UserProfile {
  id                String                 @id @default(uuid())
  userId            String                 @unique
  fullName          String
  displayName       String?
  gender            String?
  dob               DateTime?
  profileImage      String?
  email             String?                @unique
  phone             String?                @unique
  alternateEmail    String?
  alternatePhone    String?
  accountStatus     String                 @default("ACTIVE")
  verificationLevel String                 @default("BASIC")
  loyaltyTier       String                 @default("BRONZE")
  lifetimeValue     Float                  @default(0)
  totalOrders       Int                    @default(0)
  totalSpent        Float                  @default(0)
  lastActiveAt      DateTime?
  lastPurchaseAt    DateTime?
  engagementScore   Float                  @default(0)
  churnRisk         Float                  @default(0)
  fraudRisk         Float                  @default(0)
  preferences       Json?
  metadata          Json?
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  activityLogs      ProfileActivity[]
  addresses         ProfileAddress[]
  communications    ProfileCommunication[]
  devices           ProfileDevice[]
  loyaltyAccount    ProfileLoyalty?
  notes             ProfileNote[]
  user              User                   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([email])
  @@index([phone])
  @@index([accountStatus])
  @@index([verificationLevel])
  @@index([loyaltyTier])
  @@index([lastActiveAt])
  @@index([lifetimeValue])
  @@index([churnRisk])
}

model ProfileAddress {
  id           String      @id @default(uuid())
  profileId    String
  name         String
  phone        String
  line1        String
  line2        String?
  landmark     String?
  city         String
  state        String
  pincode      String
  country      String      @default("India")
  type         String
  isDefault    Boolean     @default(false)
  label        String?
  instructions String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  profile      UserProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
  @@index([type])
  @@index([pincode])
  @@index([city])
}

model ProfileActivity {
  id         String      @id @default(uuid())
  profileId  String
  type       String
  action     String?
  category   String?
  entityType String?
  entityId   String?
  entityName String?
  metadata   Json?
  value      Float?
  sessionId  String?
  referrer   String?
  page       String?
  ip         String?
  userAgent  String?
  device     String?
  os         String?
  browser    String?
  country    String?
  region     String?
  city       String?
  timezone   String?
  duration   Int?
  createdAt  DateTime    @default(now())
  profile    UserProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
  @@index([type])
  @@index([action])
  @@index([entityType, entityId])
  @@index([sessionId])
  @@index([createdAt])
  @@index([device])
}

model ProfileDevice {
  id               String      @id @default(uuid())
  profileId        String
  deviceId         String      @unique
  deviceName       String?
  deviceType       String
  os               String
  osVersion        String?
  browser          String
  browserVersion   String?
  screenResolution String?
  language         String?
  timezone         String?
  country          String?
  region           String?
  city             String?
  latitude         Float?
  longitude        Float?
  firstSeen        DateTime    @default(now())
  lastSeen         DateTime
  lastIp           String?
  loginCount       Int         @default(1)
  isActive         Boolean     @default(true)
  isTrusted        Boolean     @default(false)
  riskScore        Float       @default(0)
  metadata         Json?
  profile          UserProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
  @@index([deviceId])
  @@index([lastSeen])
  @@index([isActive])
  @@index([isTrusted])
}

model ProfileLoyalty {
  id                String               @id @default(uuid())
  profileId         String               @unique
  points            Int                  @default(0)
  lifetimePoints    Int                  @default(0)
  pointsRedeemed    Int                  @default(0)
  pointsExpiring    Int                  @default(0)
  nextExpiryDate    DateTime?
  tier              String               @default("BRONZE")
  tierSince         DateTime             @default(now())
  previousTier      String?
  nextTier          String?
  pointsToNextTier  Int                  @default(0)
  lifetimeSpend     Float                @default(0)
  lifetimeOrders    Int                  @default(0)
  averageOrderValue Float                @default(0)
  highestOrderValue Float                @default(0)
  redeemedCount     Int                  @default(0)
  redeemedValue     Float                @default(0)
  benefitsUsed      Json?
  lastEarned        DateTime?
  lastRedeemed      DateTime?
  anniversaryDate   DateTime             @default(now())
  referralCode      String?              @unique
  referralsCount    Int                  @default(0)
  referralEarnings  Float                @default(0)
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  transactions      LoyaltyTransaction[]
  profile           UserProfile          @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
  @@index([tier])
  @@index([points])
  @@index([referralCode])
}

model LoyaltyTransaction {
  id            String         @id @default(uuid())
  loyaltyId     String
  type          String
  points        Int
  description   String
  reference     String?
  balanceBefore Int
  balanceAfter  Int
  expiresAt     DateTime?
  expired       Boolean        @default(false)
  metadata      Json?
  source        String?
  createdBy     String?
  createdAt     DateTime       @default(now())
  loyalty       ProfileLoyalty @relation(fields: [loyaltyId], references: [id], onDelete: Cascade)

  @@index([loyaltyId])
  @@index([type])
  @@index([createdAt])
  @@index([expiresAt])
  @@index([source])
}

model ProfileCommunication {
  id           String      @id @default(uuid())
  profileId    String
  type         String
  channel      String
  templateId   String?
  subject      String?
  message      String
  htmlContent  String?
  status       String
  sentAt       DateTime?
  deliveredAt  DateTime?
  openedAt     DateTime?
  clickedAt    DateTime?
  failedAt     DateTime?
  openCount    Int         @default(0)
  clickCount   Int         @default(0)
  linksClicked Json?
  error        String?
  errorCode    String?
  metadata     Json?
  createdAt    DateTime    @default(now())
  profile      UserProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
  @@index([type])
  @@index([channel])
  @@index([status])
  @@index([createdAt])
  @@index([templateId])
}

model ProfileNote {
  id         String      @id @default(uuid())
  profileId  String
  title      String?
  note       String
  category   String?
  priority   String?
  isActive   Boolean     @default(true)
  isPrivate  Boolean     @default(false)
  tags       String[]    @default([])
  followUpAt DateTime?
  followUpBy String?
  resolved   Boolean     @default(false)
  resolvedAt DateTime?
  createdBy  String
  updatedBy  String?
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  profile    UserProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
  @@index([category])
  @@index([priority])
  @@index([createdBy])
  @@index([followUpAt])
  @@index([resolved])
}

model DomainEventLog {
  id            String   @id @default(uuid())
  eventId       String   @unique
  eventType     String
  version       String
  payload       Json
  metadata      Json?
  occurredAt    DateTime
  correlationId String?
  actor         String?
  tenantId      String?
  createdAt     DateTime @default(now())

  @@index([eventType])
  @@index([correlationId])
  @@index([occurredAt])
}

model UserIntelligence {
  id                String    @id @default(uuid())
  userId            String    @unique
  tenantId          String?
  ltv               Float     @default(0)
  aov               Float     @default(0)
  orderCount        Int       @default(0)
  totalSpent        Float     @default(0)
  lastOrderAt       DateTime?
  lastActiveAt      DateTime  @default(now())
  sessionCount      Int       @default(1)
  productViewsCount Int       @default(0)
  cartAdditions     Int       @default(0)
  checkoutAttempts  Int       @default(0)
  abandonedCarts    Int       @default(0)
  conversionScore   Float     @default(0)
  churnScore        Float     @default(0)
  riskScore         Float     @default(0)
  trustIndex        Float     @default(0.5)
  lifecycleStage    String    @default("NEW")
  categoryAffinity  Json?
  behavioralSignals Json?
  confidenceBands   Json?
  updatedAt         DateTime  @updatedAt
  createdAt         DateTime  @default(now())
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([lifecycleStage])
  @@index([riskScore])
  @@index([ltv])
}

model BehavioralEvent {
  id         String   @id @default(uuid())
  userId     String?
  eventType  String
  entityId   String?
  entityType String?
  payload    Json?
  metadata   Json?
  occurredAt DateTime @default(now())

  @@index([userId, eventType])
  @@index([occurredAt])
}

model LogisticsPartner {
  id                String     @id @default(uuid())
  name              String     @unique
  code              String     @unique
  type              String
  contactPerson     String?
  contactEmail      String?
  contactPhone      String?
  capabilities      Json
  supportedPincodes Json?
  apiKey            String?
  apiSecret         String?
  apiUrl            String?
  isActive          Boolean    @default(true)
  reliabilityScore  Float      @default(0.0)
  avgDeliveryDays   Float      @default(0.0)
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt
  shipments         Shipment[]
}

model Shipment {
  id                 String           @id @default(uuid())
  orderId            String           @unique
  partnerId          String
  trackingNumber     String?          @unique
  labelUrl           String?
  status             String           @default("MANIFESTED")
  weight             Float?
  dimensions         Json?
  manifestedAt       DateTime         @default(now())
  shippedAt          DateTime?
  expectedDeliveryAt DateTime?
  actualDeliveryAt   DateTime?
  waybill            String?
  manifestId         String?
  order              Order            @relation(fields: [orderId], references: [id])
  partner            LogisticsPartner @relation(fields: [partnerId], references: [id])

  @@index([orderId])
  @@index([partnerId])
  @@index([trackingNumber])
  @@index([status])
}

model DecisionPolicy {
  id          String               @id @default(uuid())
  name        String               @unique
  description String?
  category    String
  priority    Int                  @default(0)
  isActive    Boolean              @default(true)
  rules       Json
  thresholds  Json?
  version     Int                  @default(1)
  updatedAt   DateTime             @updatedAt
  createdAt   DateTime             @default(now())
  decisions   AutonomousDecision[]

  @@index([category])
  @@index([isActive])
}

model AutonomousDecision {
  id              String          @id @default(uuid())
  policyId        String
  policyVersion   Int
  triggerSignal   String
  triggerPayload  Json?
  confidenceScore Float           @default(1.0)
  impactLevel     String          @default("LOW")
  status          String          @default("PENDING")
  actionTaken     String
  actionResponse  Json?
  errorMessage    String?
  correlationId   String?
  entityType      String?
  entityId        String?
  isOverridden    Boolean         @default(false)
  overriddenBy    String?
  overrideReason  String?
  executedAt      DateTime?
  updatedAt       DateTime        @updatedAt
  createdAt       DateTime        @default(now())
  agentProposals  AgentProposal[]
  policy          DecisionPolicy  @relation(fields: [policyId], references: [id])

  @@index([policyId])
  @@index([status])
  @@index([correlationId])
  @@index([entityId])
  @@index([createdAt])
}

model AgentSession {
  id            String          @id @default(uuid())
  tenantId      String?
  userId        String?
  adminId       String?
  agentType     AgentType
  topic         String?
  correlationId String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  messages      AgentMessage[]
  proposals     AgentProposal[]

  @@index([agentType])
  @@index([userId])
  @@index([adminId])
  @@index([correlationId])
  @@index([tenantId])
}

model AgentMessage {
  id        String           @id @default(uuid())
  sessionId String
  role      AgentMessageRole
  kind      AgentMessageKind
  content   String
  payload   Json?
  createdAt DateTime         @default(now())
  session   AgentSession     @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([role])
  @@index([kind])
  @@index([createdAt])
}

model AgentProposal {
  id               String              @id @default(uuid())
  sessionId        String
  agentType        AgentType
  targetEntityType String
  targetEntityId   String?
  suggestedAction  String
  rationale        Json?
  confidenceScore  Float?
  status           String              @default("PENDING")
  adeDecisionId    String?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  adeDecision      AutonomousDecision? @relation(fields: [adeDecisionId], references: [id])
  session          AgentSession        @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([agentType])
  @@index([targetEntityType, targetEntityId])
  @@index([status])
  @@index([adeDecisionId])
}

/// Raw Razorpay webhook event snapshot with idempotency protection
model WebhookEvent {
  id             String    @id @default(uuid())
  eventId        String    @unique
  eventType      String
  rawPayload     Json
  status         String    @default("RECEIVED")
  processingLog  Json?
  retryCount     Int       @default(0)
  lastError      String?
  correlationId  String?
  idempotencyKey String?   @unique
  processedAt    DateTime?
  deadLetteredAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([eventType])
  @@index([status])
  @@index([correlationId])
  @@index([createdAt])
}

/// Canonical payment entity persisted on every gateway event
model PaymentRecord {
  id                String    @id @default(uuid())
  razorpayPaymentId String    @unique
  razorpayOrderId   String?
  orderId           String?
  userId            String?
  amountPaise       Int
  currency          String    @default("INR")
  status            String    @default("CREATED")
  method            String?
  bank              String?
  wallet            String?
  vpa               String?
  email             String?
  contact           String?
  description       String?
  international     Boolean   @default(false)
  captured          Boolean   @default(false)
  capturedAt        DateTime?
  authorizedAt      DateTime?
  errorCode         String?
  errorDescription  String?
  errorSource       String?
  errorStep         String?
  errorReason       String?
  fraudScore        Float?
  gatewayMetadata   Json?
  retryEligible     Boolean   @default(false)
  recoveryState     String?
  idempotencyKey    String?   @unique
  correlationId     String?
  tenantId          String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([razorpayOrderId])
  @@index([orderId])
  @@index([status])
  @@index([userId])
  @@index([createdAt])
}

/// Immutable audit trail for every payment lifecycle transition
model PaymentAuditLog {
  id             String   @id @default(uuid())
  paymentId      String?
  orderId        String?
  eventType      String
  fromStatus     String?
  toStatus       String?
  actor          String   @default("SYSTEM")
  actorId        String?
  metadata       Json?
  correlationId  String?
  webhookEventId String?
  occurredAt     DateTime @default(now())

  @@index([paymentId])
  @@index([orderId])
  @@index([eventType])
  @@index([occurredAt])
}

/// Refund lifecycle tracking with lineage to original payment/order
model RefundRecord {
  id                String    @id @default(uuid())
  razorpayRefundId  String    @unique
  razorpayPaymentId String
  orderId           String?
  amountPaise       Int
  currency          String    @default("INR")
  status            String    @default("INITIATED")
  speedProcessed    String?
  notes             Json?
  receipt           String?
  batchId           String?
  acquirerData      Json?
  processedAt       DateTime?
  failedAt          DateTime?
  failureReason     String?
  retryCount        Int       @default(0)
  idempotencyKey    String?   @unique
  correlationId     String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([razorpayPaymentId])
  @@index([orderId])
  @@index([status])
  @@index([createdAt])
}

/// Payment dispute lifecycle tracking
model DisputeRecord {
  id                String    @id @default(uuid())
  razorpayDisputeId String    @unique
  razorpayPaymentId String
  orderId           String?
  amountPaise       Int
  currency          String    @default("INR")
  status            String
  phase             String
  reason            String?
  respondBy         DateTime?
  lostAt            DateTime?
  wonAt             DateTime?
  evidence          Json?
  correlationId     String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([razorpayPaymentId])
  @@index([status])
  @@index([phase])
}

/// Subscription lifecycle tracking
model SubscriptionRecord {
  id                     String    @id @default(uuid())
  razorpaySubscriptionId String    @unique
  planId                 String?
  customerId             String?
  userId                 String?
  status                 String
  currentStart           DateTime?
  currentEnd             DateTime?
  endedAt                DateTime?
  quantity               Int       @default(1)
  totalCount             Int?
  paidCount              Int       @default(0)
  remainingCount         Int?
  chargeAt               DateTime?
  notes                  Json?
  correlationId          String?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  @@index([status])
  @@index([userId])
}

/// Settlement processing and reconciliation tracking
model SettlementRecord {
  id                   String    @id @default(uuid())
  razorpaySettlementId String    @unique
  entityType           String    @default("settlement")
  amountPaise          Int
  currency             String    @default("INR")
  status               String
  fees                 Int       @default(0)
  tax                  Int       @default(0)
  utr                  String?
  description          String?
  settledAt            DateTime?
  reconciledAt         DateTime?
  isReconciled         Boolean   @default(false)
  correlationId        String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@index([status])
  @@index([isReconciled])
  @@index([settledAt])
}

/// Payment link lifecycle tracking
model PaymentLinkRecord {
  id                String    @id @default(uuid())
  razorpayLinkId    String    @unique
  amountPaise       Int
  currency          String    @default("INR")
  status            String
  description       String?
  expiresAt         DateTime?
  paidAt            DateTime?
  razorpayPaymentId String?
  shortUrl          String?
  referenceId       String?
  customerId        String?
  userId            String?
  notes             Json?
  correlationId     String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([status])
  @@index([userId])
}

/// Internal domain event outbox for async downstream consumers
model DomainEventOutbox {
  id            String    @id @default(uuid())
  eventType     String
  aggregateType String
  aggregateId   String
  payload       Json
  correlationId String?
  published     Boolean   @default(false)
  publishedAt   DateTime?
  retryCount    Int       @default(0)
  lastError     String?
  createdAt     DateTime  @default(now())

  @@index([published])
  @@index([eventType])
  @@index([aggregateId])
  @@index([createdAt])
}

/// Financial reconciliation ledger for consistency guarantees
model ReconciliationLedger {
  id                   String    @id @default(uuid())
  orderId              String?
  razorpayPaymentId    String?
  razorpayOrderId      String?
  razorpayRefundId     String?
  razorpaySettlementId String?
  type                 String
  expectedAmountPaise  Int?
  actualAmountPaise    Int?
  discrepancy          Int?
  status               String    @default("PENDING")
  notes                String?
  resolvedAt           DateTime?
  correlationId        String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@index([orderId])
  @@index([status])
  @@index([type])
}

