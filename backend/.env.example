# Server Configuration
PORT=4000
NODE_ENV=production

# Database Configuration (PostgreSQL / Supabase Connection String)
DATABASE_URL="postgresql://postgres:password@db.example.supabase.co:5432/postgres?schema=public"

# Authentication Secrets (REQUIRED by Express backend)
JWT_ACCESS_SECRET="your_jwt_access_secret_here_min_32_chars"
JWT_REFRESH_SECRET="your_jwt_refresh_secret_here_min_32_chars"
ADMIN_JWT_SECRET="your_admin_jwt_secret_here_min_32_chars"

# Token Expiry Settings
JWT_ACCESS_EXPIRY="15m"
JWT_REFRESH_EXPIRY="7d"
ADMIN_JWT_EXPIRES_IN="24h"

# Password Hashing
BCRYPT_SALT_ROUNDS=12

# CORS & Domain Configuration
CORS_ORIGIN="https://bombaybaghouse.vercel.app"
CORS_ALLOWED_ORIGINS="https://bombaybaghouse.vercel.app,https://trivenibombaybaghouse.vercel.app"
FRONTEND_URL="https://bombaybaghouse.vercel.app"
BACKEND_URL="https://bombaybaghouse.onrender.com"

# Razorpay Payment Gateway (Test or Live)
RAZORPAY_KEY_ID="rzp_test_your_key_id"
RAZORPAY_KEY_SECRET="your_razorpay_secret"
RAZORPAY_WEBHOOK_SECRET="your_razorpay_webhook_secret"

# Supabase Server Integration (Backend Only - NEVER expose Service Role Key to frontend!)
SUPABASE_URL="https://xyz.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your_supabase_service_role_key"

# Initial Super Admin Credentials (Seeded on first boot)
ADMIN_EMAIL="admin@bombaybaghouse.com"
ADMIN_PASSWORD="your_secure_admin_password"
ADMIN_NAME="Super Admin"
ADMIN_ROLE="SUPER_ADMIN"

# Email Configuration (SMTP)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="support@bombaybaghouse.com"
SMTP_PASS="your_smtp_app_password"
SMTP_FROM_NAME="Bombay Bag House"
SMTP_FROM_EMAIL="support@bombaybaghouse.com"
ADMIN_RECIPIENT_EMAIL="admin@bombaybaghouse.com"
