{
	"name": "triveni-backend",
	"version": "1.0.0",
	"description": "Production-ready backend for Triveni - Imitation Jewellery Platform",
	"main": "src/index.ts",
	"scripts": {
		"build": "npx prisma generate && node scripts/esbuild-compile.js",
		"start": "node scripts/bulletproof-setup.js && node dist/index.js",
		"dev": "node scripts/dev-clean.js",
		"dev:unsafe": "tsx watch src/index.ts",
		"db:clean": "node -e \"const fs=require('fs'); const p='./node_modules/.prisma/client'; if(fs.existsSync(p)) fs.rmSync(p, {recursive: true, force: true})\"",
		"db:generate": "npm run db:clean && prisma generate",
		"db:migrate": "prisma migrate dev",
		"db:reset": "node scripts/check-env-safety.js && prisma migrate reset --force",
		"db:deploy": "prisma migrate deploy",
		"db:status": "prisma migrate status",
		"db:push": "node scripts/check-env-safety.js && prisma db push",
		"prisma:studio": "prisma studio",
		"setup": "node scripts/check-env-safety.js && npm install && npm run db:generate && npm run db:reset && npm run dev",
		"test": "vitest run",
		"lint": "biome check .",
		"format": "biome format --write ."
	},
	"dependencies": {
		"@aws-sdk/client-s3": "^3.989.0",
		"@aws-sdk/lib-storage": "^3.989.0",
		"@prisma/client": "^6.19.2",
		"@socket.io/redis-adapter": "^8.3.0",
		"@supabase/supabase-js": "^2.95.3",
		"@types/cookie-parser": "^1.4.10",
		"@types/multer": "^2.0.0",
		"@types/qrcode": "^1.5.6",
		"@types/swagger-ui-express": "^4.1.8",
		"bcryptjs": "^2.4.3",
		"canvas": "^3.2.1",
		"cookie-parser": "^1.4.7",
		"cors": "^2.8.5",
		"csv-parse": "^5.6.0",
		"dotenv": "^16.4.7",
		"esbuild": "^0.28.0",
		"express": "^5.2.1",
		"express-rate-limit": "^7.5.0",
		"firebase-admin": "^13.8.0",
		"google-auth-library": "^10.6.2",
		"handlebars": "^4.7.8",
		"helmet": "^8.0.0",
		"jsbarcode": "^3.12.3",
		"jsonwebtoken": "^9.0.2",
		"morgan": "^1.10.0",
		"multer": "^2.0.2",
		"multer-s3": "^3.0.1",
		"nodemailer": "^8.0.0",
		"pdf-lib": "^1.17.1",
		"pg": "^8.13.1",
		"puppeteer": "^24.37.1",
		"qrcode": "^1.5.4",
		"razorpay": "^2.9.4",
		"redis": "^5.10.0",
		"sharp": "^0.34.5",
		"slugify": "^1.6.6",
		"socket.io": "^4.8.3",
		"swagger-ui-express": "^5.0.1",
		"uuid": "^13.0.0",
		"winston": "^3.17.0",
		"zod": "^3.24.1"
	},
	"devDependencies": {
		"@biomejs/biome": "2.2.0",
		"@types/bcryptjs": "^2.4.6",
		"@types/bun": "^1.3.6",
		"@types/cors": "^2.8.17",
		"@types/express": "^5.0.0",
		"@types/jsonwebtoken": "^9.0.7",
		"@types/morgan": "^1.9.9",
		"@types/node": "^22.19.8",
		"@types/nodemailer": "^7.0.9",
		"@types/socket.io": "^3.0.1",
		"@types/supertest": "^6.0.3",
		"@types/uuid": "^10.0.0",
		"prisma": "^6.2.1",
		"supertest": "^7.2.2",
		"ts-node": "^10.9.2",
		"tsx": "^4.21.0",
		"typescript": "^5.9.3",
		"vitest": "^4.0.17"
	}
}
